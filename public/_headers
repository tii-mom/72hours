# Cloudflare Pages response headers.

/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), xr-spatial-tracking=(), fullscreen=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-XlrUFr2RJ+fxmMLlqfWSokMLOPy3DfcnKSS16zfebQA='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://tonviewer.com https://*.tonviewer.com https://raw.githubusercontent.com; connect-src 'self' https://capital-api.72h.lol https://capital-indexer.72h.lol https://toncenter.com https://tonapi.io https://tonviewer.com https://bridge.tonapi.io https://walletbot.me https://wallet.telegram.org https://wallet.tg https://app.tonkeeper.com https://mytonwallet.io https://app.tonhub.com wss://bridge.tonapi.io; frame-src 'self' https://bridge.tonapi.io https://walletbot.me https://app.tonkeeper.com https://*.tonkeeper.com https://mytonwallet.io https://wallet.telegram.org https://wallet.tg https://app.tonhub.com; manifest-src 'self'; media-src 'self' data:; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-DNS-Prefetch-Control: on
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/brands/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
