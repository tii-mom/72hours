# 72H Capital production gate example.
# Copy to an ignored local file such as `.env.production.local` and fill real values.
# Do not commit secrets or real private URLs that should remain private.

# Capital Reserve/AppRewardPool v1 signing stays fail-closed by default.
# Telegram presale/V2 website flows use the H72H_* presale config below and must not rely on these Capital signing addresses.
CAPITAL_MAINNET_SIGNING_ENABLED=false
CAPITAL_PRODUCTION_API_BASE_URL=https://capital-api.72h.lol
CAPITAL_PRODUCTION_INDEXER_BASE_URL=https://capital-indexer.72h.lol
CAPITAL_TONCONNECT_MANIFEST_URL=https://72h.lol/tonconnect-manifest.json
CAPITAL_MAINNET_RPC_URL=https://toncenter.com/api/v2
CAPITAL_MAINNET_EXPLORER_TX_URL_PATTERN=https://tonviewer.com/transaction/{tx}

TON_MAINNET_72H_JETTON_MASTER_ADDRESS=EQBGIzEDvvKObStrcVb6i5Z1-8uYZYtUrYzF2rFZU7xUAXVg
TON_MAINNET_ADMIN_ADDRESS=
# Historical Capital Reserve/AppRewardPool v1 address draft, retained only for signing-gate validation.
# Do not present these as Telegram presale/V2 token sale contracts.
# Do not treat them as deployed evidence until tx hashes, official V2 Jetton-wallet getter snapshots, audit, legal approval, and owner signoff are attached.
TON_MAINNET_RESERVE_VAULT_ADDRESS_72HOURS=EQAUMyjNfWsO59Dtof6SYU06q7XVoE9uKH8ZQSZX0QvhRNKl
TON_MAINNET_RESERVE_VAULT_JETTON_WALLET_ADDRESS_72HOURS=
TON_MAINNET_APP_REWARD_POOL_ADDRESS_72HOURS=EQCRZu-RjCTPK7DL5q8hVD1-9FN4UE0lIbILi-YgHBuSQ0wr
TON_MAINNET_APP_REWARD_POOL_JETTON_WALLET_ADDRESS_72HOURS=
TON_MAINNET_ALPHA_VAULT_ADDRESS_72HOURS=EQB6X068UH5fqETc7Tk0IrxPBCqI8Hsmg_wC5BzE21UPi6jq
TON_MAINNET_RESERVE_VAULT_ADDRESS_WAN=EQC3nbivC7_iqdCEBJ-5PDzI4gyz9ytF-BJmgeTimrAi70qq
TON_MAINNET_RESERVE_VAULT_JETTON_WALLET_ADDRESS_WAN=
TON_MAINNET_APP_REWARD_POOL_ADDRESS_WAN=EQAVZqKSLamdNARoQzYK_SDS_Gkr_Wg83z-NdWaeOKD6Fra4
TON_MAINNET_APP_REWARD_POOL_JETTON_WALLET_ADDRESS_WAN=
TON_MAINNET_ALPHA_VAULT_ADDRESS_WAN=EQBCeUNyTbZSLdQ5aZl-ROiZ_gXDqILb59Npwh7uikWnk_qr
TON_MAINNET_RESERVE_VAULT_ADDRESS_MULTI_MILLIONAIRE=EQBPkl46BiuEifiurq6hGtjjXjeooGp8tjDpNuMHZOsxZN5v
TON_MAINNET_RESERVE_VAULT_JETTON_WALLET_ADDRESS_MULTI_MILLIONAIRE=
TON_MAINNET_APP_REWARD_POOL_ADDRESS_MULTI_MILLIONAIRE=EQB9PmfGy_2BWj4RJW0b67iaGmvrPFth88HwnWI7HWbJP_1Z
TON_MAINNET_APP_REWARD_POOL_JETTON_WALLET_ADDRESS_MULTI_MILLIONAIRE=
TON_MAINNET_ALPHA_VAULT_ADDRESS_MULTI_MILLIONAIRE=EQAzVQLvyrbQds7btOST69nrIqqPqp-R3MlsFHIFyUgHLLCk

H72H_CAPITAL_DB_MODE=postgres
DATABASE_URL=
H72H_TELEGRAM_BOT_TOKEN=
H72H_TELEGRAM_WEBHOOK_SECRET=
H72H_TELEGRAM_ADMIN_IDS=
H72H_TELEGRAM_ALERT_CHAT_ID=
H72H_BOT_PUBLIC_BASE_URL=https://72hours.72h.lol
H72H_BOT_MINIAPP_URL=https://72hours.72h.lol/bot/presale
H72H_BOT_INTENT_SIGNING_SECRET=
# Cloudflare KV binding required in wrangler.toml, not a string env:
# H72H_BOT_SALES_KV
# 72H Telegram presale / V2 website runtime. This is separate from Capital Reserve/AppRewardPool v1.
# BOT-only warmup/waitlist default; sale_ready/sale_live are clamped unless H72H_ALLOW_SALE_MODES=true.
# Real purchases stay disabled unless this is true.
H72H_PRESALE_MODE=warmup
H72H_ALLOW_SALE_MODES=false
H72H_PRESALE_ENABLED=false
H72H_PRESALE_NETWORK_MODE=mainnet
H72H_PRESALE_VAULT_ADDRESS=EQCj56OaGFtIBgdtQjIacb7s1jlEy93vh-93PU07MDR1vpE9
H72H_72H_JETTON_MASTER=EQBGIzEDvvKObStrcVb6i5Z1-8uYZYtUrYzF2rFZU7xUAXVg
H72H_TON_RPC_URL=
H72H_TON_API_KEY=
CAPITAL_MONITORING_OWNER=72H owner
CAPITAL_ROLLBACK_APPROVAL_OWNER=72H owner

CAPITAL_TONCONNECT_BRIDGE_ORIGINS=https://bridge.tonapi.io,https://walletbot.me,https://wallet.telegram.org,https://wallet.tg,https://app.tonkeeper.com,https://mytonwallet.io,https://app.tonhub.com
CAPITAL_CSP_CONNECT_SRC='self' https://capital-api.72h.lol https://capital-indexer.72h.lol https://toncenter.com https://tonapi.io https://tonviewer.com https://bridge.tonapi.io https://walletbot.me https://wallet.telegram.org https://wallet.tg https://app.tonkeeper.com https://mytonwallet.io https://app.tonhub.com wss://bridge.tonapi.io
CAPITAL_CSP_FRAME_SRC='self' https://bridge.tonapi.io https://walletbot.me https://app.tonkeeper.com https://*.tonkeeper.com https://mytonwallet.io https://wallet.telegram.org https://wallet.tg https://app.tonhub.com
CAPITAL_CSP_IMG_SRC='self' data: blob: https://tonviewer.com https://*.tonviewer.com https://raw.githubusercontent.com
CAPITAL_CSP_MANIFEST_SRC='self' https://72h.lol

CAPITAL_AUDIT_REPORT_PATH=
CAPITAL_LEGAL_APPROVAL_PATH=
CAPITAL_TESTNET_REHEARSAL_ARTIFACT_PATH=
CAPITAL_RESERVE_VAULT_REDEMPTION_VERIFICATION_PATH=
CAPITAL_APP_REWARD_POOL_POLICY_PATH=
