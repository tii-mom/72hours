# Optional: disable Vite HMR while doing long-running automated edits.
DISABLE_HMR="false"

# 72H Capital runtime. Deploy environments can set this to "api".
VITE_CAPITAL_DATA_MODE="preview"
VITE_CAPITAL_API_BASE_URL="/v1/capital"

# Local dev proxy target for the Capital API service
VITE_CAPITAL_PROXY_TARGET="http://localhost:3001"

# Optional: override TonConnect manifest location
VITE_TONCONNECT_MANIFEST_URL="/tonconnect-manifest.json"

# Cloudflare Pages Functions bindings/secrets:
# - APP_DISCOVERY_KV stores Telegram Bot app records.
# - HOURS_VERIFICATION_KV stores 72H balance proof traces.
# - H72H_TELEGRAM_BOT_SECRET is sent as x-telegram-bot-secret by the bot.
H72H_TELEGRAM_BOT_SECRET=""

# 72H Telegram sales bot / V2 presale surface.
# Keep this separate from historical Capital Reserve/AppRewardPool v1 signing config.
# Keep token and webhook secret in Cloudflare secrets, not public Vite env.
H72H_TELEGRAM_BOT_TOKEN=""
H72H_TELEGRAM_WEBHOOK_SECRET=""
H72H_TELEGRAM_ADMIN_IDS=""
H72H_TELEGRAM_ALERT_CHAT_ID=""
H72H_BOT_PUBLIC_BASE_URL=""
H72H_BOT_MINIAPP_URL=""
H72H_BOT_INTENT_SIGNING_SECRET=""
# Cloudflare KV binding required in deployment, not a string env:
# H72H_BOT_SALES_KV

# 72H V2 presale runtime. Real purchases stay disabled unless this is true.
# Official V2 Jetton master only; do not use the legacy pre-V2 EQDvE0... address here.
H72H_PRESALE_ENABLED="false"
H72H_PRESALE_NETWORK_MODE="mainnet"
H72H_PRESALE_VAULT_ADDRESS="EQCj56OaGFtIBgdtQjIacb7s1jlEy93vh-93PU07MDR1vpE9"
H72H_72H_JETTON_MASTER="EQBGIzEDvvKObStrcVb6i5Z1-8uYZYtUrYzF2rFZU7xUAXVg"
H72H_TON_RPC_URL=""
H72H_TON_API_KEY=""
